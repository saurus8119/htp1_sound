#!/bin/sh
# Shairport Sync passes its volume in dB: 0 dB is full volume; -144 dB is mute.
# addon-source expects a normalized fraction over a 60 dB range.
set -eu
[ "$#" -eq 1 ] || exit 0
case "$1" in
  ''|*[!0-9.-]*) exit 0 ;;
esac
# Treat Shairport's -144 dB sentinel as mute. Otherwise map [-60, 0] dB to [0, 1].
if awk -v db="$1" 'BEGIN { exit !(db <= -143) }'; then
  exec /opt/olympia/addon-source mute airplay
fi
fraction=$(awk -v db="$1" 'BEGIN { f=(db+60)/60; if (f<0) f=0; if (f>1) f=1; printf "%.6f", f }')
exec /opt/olympia/addon-source volume airplay "$fraction"
