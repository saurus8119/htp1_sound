#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ADDON_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Install the add-on's bundled Debian 9 ARMHF runtime packages.
shopt -s nullglob
RUNTIME_DEBS=("$ADDON_DIR"/debs/*.deb)
if (("${#RUNTIME_DEBS[@]}" > 0)); then
  dpkg -i "${RUNTIME_DEBS[@]}"
fi

if ! command -v smbclient >/dev/null 2>&1; then
  echo "HTPlay-1 install failed: bundled smbclient was not installed." >&2
  exit 1
fi

UPLOAD_CONFIG="$ADDON_DIR/etc/htplay1.conf"
if [ -f "$UPLOAD_CONFIG" ]; then
  chown root:root "$UPLOAD_CONFIG"
  chmod 600 "$UPLOAD_CONFIG"
fi

# Persistent local logs are limited to Shairport Sync and NQPTP.
LOG_DIR="$ADDON_DIR/logs"
mkdir -p "$LOG_DIR"
touch "$LOG_DIR/airplay2.log" "$LOG_DIR/nqptp-airplay2.log"
chown -R root:root "$LOG_DIR"
chmod 700 "$LOG_DIR"
chmod 600 "$LOG_DIR"/*.log

# Avahi is shared by network-discovery services; the add-on unit pulls it in.
systemctl disable avahi-daemon.service avahi-daemon.socket >/dev/null 2>&1 || true
systemctl daemon-reload >/dev/null 2>&1 || true
exit 0
