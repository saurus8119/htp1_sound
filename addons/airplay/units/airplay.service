[Unit]
Description=HTP-1 AirPlay receiver (Shairport Sync)
After=network.target nqptp.service
Wants=nqptp.service

[Service]
Type=simple
ExecStart=/var/lib/olympia/addons/airplay/bin/shairport-sync --configfile=/var/lib/olympia/addons/airplay/etc/shairport-sync.conf
Restart=on-failure
RestartSec=2
Environment=LD_LIBRARY_PATH=/var/lib/olympia/addons/airplay/lib:/usr/local/lib
User=root
Group=root

[Install]
WantedBy=multi-user.target
