[Unit]
Description=AirPlay 2.0 receiver (Shairport Sync)
Requires=nqptp-airplay2.service avahi-daemon.service
After=network.target nqptp-airplay2.service avahi-daemon.service

[Service]
Type=simple
User=root
Environment=LD_LIBRARY_PATH=/var/lib/olympia/addons/airplay2/lib:/usr/local/lib
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=45
ExecStart=/bin/bash -c 'NAME="HTPlay-1"; exec /var/lib/olympia/addons/airplay2/bin/shairport-sync --configfile=/var/lib/olympia/addons/airplay2/etc/shairport-sync.conf -a "$NAME"'
ExecStartPost=/bin/bash -c 'echo $MAINPID > /sys/fs/cgroup/cpuset/user/cgroup.procs 2>/dev/null || true'
KillSignal=SIGINT
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
