[Unit]
Description=HTPlay-1 add-on log capture and periodic upload
After=network.target
Before=airplay2.service nqptp-airplay2.service

[Service]
Type=simple
User=root
ExecStart=/var/lib/olympia/addons/airplay2/bin/capture-logs.sh
Restart=always
RestartSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target
