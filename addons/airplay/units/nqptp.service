[Unit]
Description=HTP-1 AirPlay 2 timing daemon (NQPTP)
After=network.target

[Service]
Type=simple
ExecStart=/var/lib/olympia/addons/airplay/bin/nqptp
Restart=on-failure
RestartSec=2
Environment=LD_LIBRARY_PATH=/var/lib/olympia/addons/airplay/lib:/usr/local/lib
User=root
Group=root

[Install]
WantedBy=multi-user.target
