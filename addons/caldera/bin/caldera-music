#!/bin/bash
set -euo pipefail

ADDON_DIR=/var/lib/olympia/addons/caldera
STATE_DIR="$ADDON_DIR/state"
CONFIG_DIR="$STATE_DIR/.config"
CONFIG_FILE="$CONFIG_DIR/caldera-music"
LOGIN_LOG="$STATE_DIR/caldera-login.typescript"
CALDERA="$ADDON_DIR/bin/caldera-music.bin"
LOADER="$ADDON_DIR/lib/ld-linux-armhf.so.3"

export HOME="$STATE_DIR"
export XDG_CONFIG_HOME="$CONFIG_DIR"

run_caldera() {
  exec "$LOADER" --library-path "$ADDON_DIR/lib" "$CALDERA" "$@"
}

mkdir -p "$CONFIG_DIR" "$STATE_DIR"

if [[ ! -x "$LOADER" ]]; then
  echo "Bundled ARMHF runtime loader is missing: $LOADER" >&2
  exit 1
fi

# HTPlex uses the bundled player for Plex authentication and playback.
TOKEN="$( "$LOADER" --library-path "$ADDON_DIR/lib" "$CALDERA" --config "$CONFIG_FILE" --get plex.token 2>/dev/null || true )"
if [[ -z "$TOKEN" || "$TOKEN" == "null" || "$TOKEN" == '\"\"' ]]; then
  : > "$LOGIN_LOG"
  if ! command -v script >/dev/null 2>&1; then
    printf '%s\n' "Cannot start Caldera PIN sign-in: the system 'script' utility is unavailable." > "$LOGIN_LOG"
    cat "$LOGIN_LOG"
    exit 1
  fi

  # Set a stable player name so the only interactive choice is Caldera's
  # first output-device option (System Default). Do not force an ALSA device.
  printf '\n' | script -q -e -c "$LOADER --library-path $ADDON_DIR/lib $CALDERA --config $CONFIG_FILE --login --player-name 'HTPlex'" "$LOGIN_LOG"
fi

# Leave audio-device selection to Caldera's built-in default-device discovery.
# Apply source-matching, unprocessed playback preferences before starting the player.
for preference in \
  audio.sampleRate=0 \
  audio.channels=0 \
  audio.masterVolume=100 \
  player.loudnessLeveling=no \
  player.sweetFades=no; do
  "$LOADER" --library-path "$ADDON_DIR/lib" "$CALDERA" --config "$CONFIG_FILE" --set "$preference"
done

run_caldera --config "$CONFIG_FILE" "$@"
