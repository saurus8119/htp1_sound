[Unit]
Description=HTP-1 Audio Diagnostics read-only local API
After=network.target

[Service]
Type=simple
User=root
ExecStart=/var/lib/olympia/addons/audio-diagnostics/bin/audio-diagnostics.py
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadOnlyPaths=/proc /sys /etc /var/log /var/lib/olympia

[Install]
WantedBy=multi-user.target
