[Unit]
Description=HTP-1 System Monitor read-only local API
After=network.target

[Service]
Type=simple
User=root
ExecStart=/var/lib/olympia/addons/system-monitor/bin/system-monitor.py
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadOnlyPaths=/proc /sys /etc /var/log /var/lib/olympia

[Install]
WantedBy=multi-user.target
